generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// Placeholder model so the first migration has something to create.
// Replace it once the hackathon task is known.
model Example {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
}
